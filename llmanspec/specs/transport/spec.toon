kind: llman.sdd.spec
name: transport
purpose: 传输层抽象，定义所有传输层必须实现的 I/O trait，支持 stdio、TCP、WebSocket 等协议。
valid_scope[2]: src/transport/,tests/
requirements[6]{req_id,title,statement}:
  r23,Transport trait,系统 MUST 定义 Transport trait 包含 receive 和 send 方法。
  r33,"Content-Length 分帧","所有传输层 MUST 处理 Content-Length 分帧协议。"
  r42,多协议支持,系统 MUST 支持 StdioTransport、TcpTransport、WsTransport 三种传输协议。
  r51,进程退出检测,Transport trait MUST 提供 try_wait 方法检测底层进程退出状态。
  r58,"Content-Length 上限","所有 Content-Length 分帧读取路径 MUST 拒绝超过 16MiB 的 body，与 codec 层上限一致。"
  r65,WebSocket Text 帧,"WsTransport MUST 接受 Text 帧并将其 UTF-8 字节作为 LSP 消息载荷，不得无限跳过 Text。"
scenarios[9]{req_id,id,given,when,then,feature}:
  r23,"stdio-transport",StdioTransport 实例,调用 receive(),"返回 Content-Length 分帧的消息",true
  r23,"tcp-transport",TcpTransport 实例,调用 receive(),"返回 Content-Length 分帧的消息",true
  r23,"ws-transport",WsTransport 实例,调用 receive(),"返回 Content-Length 分帧的消息",true
  r33,"content-length-raw",原始 LSP 消息,发送前,"自动添加 Content-Length 头",true
  r33,"content-length-parse","带 Content-Length 的消息",接收时,自动解析并提取消息体,true
  r42,"multiple-protocols",配置使用不同传输协议,Proxy 创建,成功创建对应的 Transport 实例,true
  r51,"process-exit",子进程已退出,调用 try_wait(),返回 Some(ExitStatus),true
  r58,"reject-oversized","Content-Length 声明大于 16MiB",read_frame,返回协议错误且不分配完整 body 缓冲,true
  r65,"accept-text",对端发送 WebSocket Text LSP 帧,receive,返回对应字节内容,true