kind: llman.sdd.spec
name: ssot-rules
purpose: "SSOT（单一事实源）规则，定义代码即 SSOT 的文档生成和维护规范。"
valid_scope[1]: src/
requirements[5]{req_id,title,statement}:
  r1,代码即 SSOT,系统 MUST 以代码注释（/// / //!）作为 API 文档的单一事实源。
  r2,API 文档生成,系统 MUST 使用 cargo doc 从代码注释自动生成 API 文档。
  r3,规范文档位置,系统 MUST 将规范文档放在 llmanspec/specs/ 目录。
  r4,Mermaid 图表,系统 MUST 将 Mermaid 图表放在 docs/src/diagrams/ 目录（如需要）。
  r5,文档漂移检测,系统 MUST 在 CI 中检测文档漂移（cargo doc + cargo test --doc）。
scenarios[6]{req_id,id,given,when,then}:
  r1,code-comment-ssot,"代码中的 /// 注释",cargo doc 运行,生成对应的 API 文档
  r2,cargo-doc-generate,"src/ 中的文档注释",cargo doc 运行,target/doc/ 中生成文档
  r3,specs-in-llmanspec,"规范文档",创建规范,放在 llmanspec/specs/ 目录
  r4,mermaid-in-diagrams,"Mermaid 图表",创建图表,放在 docs/src/diagrams/ 目录
  r5,ci-doc-check,"CI 运行",cargo doc --no-deps --all-features,文档构建成功无错误
  r5,ci-doc-test,"CI 运行",cargo test --doc --all-features,文档示例编译通过
