kind: llman.sdd.spec
name: codec
purpose: "编解码层，实现 JSON-RPC 2.0 协议编解码和多种输出格式（TOON、compact、passthrough）。"
valid_scope[2]: src/codec/,tests/
requirements[4]{req_id,title,statement}:
  r15,"JSON-RPC 编解码","系统 MUST 正确编解码 JSON-RPC 2.0 协议消息。"
  r25,TOON 格式,"系统 MUST 支持 TOON 输出：通知与响应均可编码为 TOON；响应 MUST 保留原 JSON-RPC id 并将 TOON 文本置于 result。"
  r34,Compact 格式,系统 MUST 支持 compact 格式，使用缩短的字段名。
  r43,Passthrough 格式,系统 MUST 支持 passthrough：Proxy 在该模式下不得改写消息体，原样转发原始 LSP JSON。
scenarios[5]{req_id,id,given,when,then,feature}:
  r15,"encode-request","JSON-RPC 请求",编码,"输出符合 JSON-RPC 2.0 规范的字节",true
  r15,"decode-response","JSON-RPC 响应字节",解码,"输出 serde_json::Value",true
  r25,"toon-response-shape",已压缩的 completion result 与请求 id,编码为 TOON 响应,"JSON-RPC 含相同 id 且 result 含 format=toon 与 text",true
  r34,"compact-diagnostics",诊断数据,compact 编码,输出缩短字段名的 JSON,true
  r43,"proxy-passthrough",Config.output_format=passthrough,拦截路径处理任意 ServerToClient 消息,输出字节与输入 raw 帧语义一致且无压缩字段,true