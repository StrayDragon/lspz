kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,r5,Daemon 优雅退出,"Daemon MUST 在 SIGINT、idle 超时与 daemon/shutdown 时先清空 LSP 会话池（触发子进程 Drop/kill）并删除真实 socket 文件，禁止在未回收子进程时直接 process::exit。",null,null,null
  add_requirement,r6,Shutdown 使用真实 socket 路径,daemon/shutdown MUST 使用服务器持有的 socket_path 删除套接字文件，不得依赖可能未设置的 LSPZ_SOCKET 环境变量。,null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  r5,"graceful-sigint",Daemon 持有已 spawn 的 LSP 子进程,收到 SIGINT 或 daemon/shutdown,会话池被清空、socket 文件被删除、子进程被终止后再退出
  r6,"socket-path","Daemon 以 --socket 路径启动且未设置 LSPZ_SOCKET",客户端调用 daemon/shutdown,该 socket 文件被删除
