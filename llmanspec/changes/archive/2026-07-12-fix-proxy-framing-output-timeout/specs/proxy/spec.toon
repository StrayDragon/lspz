kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,r6,"Cancel-safe 消息循环","系统 MUST 在 select 竞争下以 cancel-safe 方式读取完整 LSP 帧，禁止中途取消导致字节丢失与帧错位。",null,null,null
  add_requirement,r7,按 id 匹配握手与关闭响应,"系统 MUST 在 initialize 与 shutdown 流程中按 JSON-RPC id 匹配服务器响应，并将交错的通知转发给客户端。",null,null,null
  add_requirement,r8,Receive 超时,系统 MUST 对 Proxy 侧等待服务器帧的 receive 使用有限超时（默认 30s），超时返回可观测错误而非无限阻塞。,null,null,null
  modify_requirement,r4,配置驱动输出格式,系统 MUST 使用 Config 控制运行时行为，包括 OutputFormat：passthrough 原样转发，toon 对通知与响应均输出 TOON 且响应保留 id，json 输出 compact JSON。,null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  r6,"cancel-safe-loop",stdin 与 server 同时有不完整帧数据,message_loop 运行 select,任一侧只在完整帧到达后投递，另一侧未读字节保留在其 reader
  r7,"handshake-id-match",initialize 请求 id=1 且服务器先发 window/logMessage,执行握手,通知先转发给客户端，随后转发 id=1 的 initialize 响应
  r8,"receive-timeout",服务器不再发送数据,握手或消息循环等待 receive,在超时后返回错误并记录日志
  r4,"passthrough-honored",output_format=passthrough,服务器发送 publishDiagnostics,客户端收到未经压缩的原始 LSP JSON
  r4,"toon-response-keeps-id",output_format=toon 且 pending completion 请求 id=7,服务器返回 completion 响应,"客户端收到带 id=7 且 result.format=toon 的 JSON-RPC 响应"