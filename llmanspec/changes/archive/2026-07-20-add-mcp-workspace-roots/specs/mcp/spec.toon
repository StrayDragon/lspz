kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  add_requirement,r75,MCP Roots 与 peer 上下文,"MCP 服务器在客户端完成连接/initialize 后 MUST 获取并缓存 MCP Roots（若客户端声明该能力），并保留 peer_info/client_info；Roots 请求失败时 MUST WARN 并 fail-open（不中断会话），不得假装已绑定工作区。",null,null,null
  add_requirement,r76,可选 URI 与工作区解析,"MCP 工具 get_diagnostics 与 get_symbols 的 uri 参数 MUST 为可选；当 uri 缺省或为空时，系统 MUST 按 MCP Roots → 进程 cwd → detect_workspace_root 顺序解析工作区根；当 uri 非空时 MUST 继续支持显式 file://（或可规范化路径）。",null,null,null
  add_requirement,r77,无 URI 诊断摘要流,"当 get_diagnostics 在无有效 uri 且已解析到工作区时，系统 MUST 扫描/触发该工作区内相关 LSP 诊断工作，并返回面向 Agent 的 max-column/compact TOON 摘要（含截断上限），禁止因摘要失败而中断 MCP 会话（失败时 MUST 返回可行动错误文本）。",null,null,null
  add_requirement,r78,Cursor 类客户端兼容,"系统 MUST 支持 Cursor 等编码 Agent MCP 客户端：在其提供 Roots（及可识别的 client/peer 信息）时，允许省略 file:// uri 完成默认诊断摘要流；不得要求此类客户端为默认诊断调用填写绝对 URI。",null,null,null
  add_requirement,r79,Roots 内路径约束,"当会话已缓存非空 MCP Roots 时，显式 file://（或规范化后的本地路径）若落在所有 root 之外，工具调用 MUST 拒绝并返回明确错误；不得静默读取 Roots 外路径。无 Roots 时行为保持现状（不在本需求扩大为全局沙箱）。",null,null,null
op_scenarios[7]{req_id,id,given,when,then}:
  r75,"roots-cached","Cursor 类客户端已连接且声明 Roots 能力","MCP initialize/连接完成","服务器缓存至少一条 root URI 并记录 client/peer 标识"
  r75,"roots-fail-open","客户端声明 Roots 但 list/roots 请求失败","连接完成","会话仍可用且日志含 WARN，不伪称已绑定 root"
  r76,"empty-uri-resolve","已缓存 root file:///proj 且未传 uri","调用 get_diagnostics","使用 /proj（或等价 file URI）作为工作区根继续处理"
  r76,"explicit-uri","客户端传入 file:///proj/src/main.rs","调用 get_diagnostics","按该 URI 打开/诊断，不因存在 Roots 而忽略显式 URI"
  r77,"workspace-toon-summary","工作区已解析且 LSP 可返回诊断","无 uri 调用 get_diagnostics","返回 compact/max-column TOON 摘要且行数不超过配置上限"
  r78,"cursor-omit-uri","peer/client 标识为 Cursor 类且 Roots 非空","无参或空 uri 调用 get_diagnostics","成功返回摘要而非 uri required 校验错误"
  r79,"outside-roots-reject","已缓存 root file:///proj","调用工具 uri=file:///etc/passwd","返回明确越界错误且不读取该文件"
